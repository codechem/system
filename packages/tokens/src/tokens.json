{
  "$description": "SAMPLE in DTCG 2025.10 format. Replace with the Figma Variables export (Step 2).",
  "color": {
    "$type": "color",
    "blue": {
      "600": { "$value": "#2563eb" },
      "700": { "$value": "#1d4ed8" }
    },
    "gray": {
      "100": { "$value": "#f3f4f6" },
      "200": { "$value": "#e5e7eb" },
      "900": { "$value": "#111827" }
    },
    "white": { "$value": "#ffffff" },

    "action": {
      "primary": { "$value": "{color.blue.600}", "$description": "Main call-to-action background" },
      "primary-hover": { "$value": "{color.blue.700}" },
      "secondary": { "$value": "{color.gray.100}" },
      "secondary-hover": { "$value": "{color.gray.200}" }
    },
    "on-action": {
      "primary": { "$value": "{color.white}", "$description": "Text/icon on action.primary" },
      "secondary": { "$value": "{color.gray.900}" }
    },
    "focus-ring": { "$value": "{color.blue.600}" }
  },
  "space": {
    "$type": "dimension",
    "2": { "$value": { "value": 8, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "md": { "$value": { "value": 6, "unit": "px" } }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["system-ui", "sans-serif"] }
  }
}
