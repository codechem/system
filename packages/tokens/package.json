{
  "name": "@codechem/tokens",
  "version": "0.0.0",
  "description": "CodeChem design tokens (colours, typography, spacing) as CSS custom properties",
  "keywords": [
    "design-tokens",
    "css-variables",
    "css-custom-properties",
    "design-system",
    "figma",
    "codechem"
  ],
  "license": "MIT",
  "author": "CodeChem",
  "homepage": "https://github.com/codechem/system#readme",
  "bugs": {
    "url": "https://github.com/codechem/system/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codechem/system.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./sheet.js": {
      "types": "./dist/tokens-sheet.d.ts",
      "default": "./dist/tokens-sheet.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "style-dictionary build --config style-dictionary.config.mjs && node scripts/build-sheet.mjs"
  },
  "devDependencies": {
    "style-dictionary": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
