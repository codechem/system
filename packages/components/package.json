{
  "name": "@codechem/components",
  "version": "0.0.0",
  "description": "CodeChem web components built with Lit",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button.js": {
      "types": "./dist/button/cc-button.d.ts",
      "default": "./dist/button/cc-button.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "custom-elements.json",
    "vscode.html-custom-data.json"
  ],
  "scripts": {
    "analyze": "cem analyze",
    "build": "cem analyze && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@vitest/browser-playwright": "^4.1.12",
    "custom-element-vs-code-integration": "^1.5.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
