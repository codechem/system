{
  "name": "@codechem/components",
  "version": "0.0.0",
  "description": "CodeChem web components built with Lit",
  "license": "MIT",
  "homepage": "https://github.com/codechem/system#readme",
  "bugs": {
    "url": "https://github.com/codechem/system/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button.js": {
      "types": "./dist/button/cc-button.d.ts",
      "default": "./dist/button/cc-button.js"
    },
    "./alert.js": {
      "types": "./dist/alert/cc-alert.d.ts",
      "default": "./dist/alert/cc-alert.js"
    },
    "./badge.js": {
      "types": "./dist/badge/cc-badge.d.ts",
      "default": "./dist/badge/cc-badge.js"
    },
    "./checkbox.js": {
      "types": "./dist/checkbox/cc-checkbox.d.ts",
      "default": "./dist/checkbox/cc-checkbox.js"
    },
    "./link.js": {
      "types": "./dist/link/cc-link.d.ts",
      "default": "./dist/link/cc-link.js"
    },
    "./radio.js": {
      "types": "./dist/radio/cc-radio-group.d.ts",
      "default": "./dist/radio/cc-radio-group.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "custom-elements.json",
    "vscode.html-custom-data.json"
  ],
  "scripts": {
    "analyze": "cem analyze",
    "build": "cem analyze && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@codechem/tokens": "*",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@vitest/browser-playwright": "^5.1.0",
    "custom-element-vs-code-integration": "^1.5.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codechem/system.git",
    "directory": "packages/components"
  },
  "publishConfig": {
    "access": "public"
  }
}
