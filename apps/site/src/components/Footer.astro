---
import Logo from './Logo.astro';
import { external, pages, version } from '../site';
---

<footer class="site-footer">
  <div class="footer-inner">
    <a class="brand" href="/"><Logo /><span>CodeChem</span></a>
    <p>Built with <code>@codechem/components@{version}</code>, installed from npm.</p>
    <ul>{[...pages, ...external].map((p) => <li><a href={p.href}>{p.label}</a></li>)}</ul>
  </div>
</footer>
