{
  "name": "codechem-design-system",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "storybook": "npm run build -w @codechem/tokens && npm run analyze -w @codechem/components && npm run storybook -w @codechem/storybook"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "rs-module-lexer": false
  }
}
